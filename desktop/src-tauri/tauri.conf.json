{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "College Wi-Fi",
  "version": "0.1.0",
  "identifier": "edu.lnmiit.college-wifi",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "College Wi-Fi Settings",
        "width": 460,
        "height": 560,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility"
  }
}
