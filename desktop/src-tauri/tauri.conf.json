{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wi-Fi Connect",
  "version": "0.2.0",
  "identifier": "edu.lnmiit.college-wifi",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run prepare:assets",
    "beforeBuildCommand": "npm run prepare:assets && npm run build:cli"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wi-Fi Connect",
        "width": 420,
        "height": 500,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/wifi"],
    "category": "Utility",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/college-wifi-connect.desktop": "resources/college-wifi-connect.desktop",
          "/usr/bin/wifi": "binaries/wifi"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "resources/windows-shortcut.nsh"
      }
    }
  }
}
